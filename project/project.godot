; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.

config_version=5

[application]

config/name="刀剑神域：艾恩葛朗特第一层（同人原型）"
config/description="SAO Aincrad Floor 1 fan-made pixel RPG prototype. 同人学习用途原型，非官方产品。"
config/use_custom_user_dir=true
config/custom_user_dir_name="AincradProto"
run/main_scene="res://scenes/title.tscn"
config/features=PackedStringArray("4.4", "GL Compatibility")
boot_splash/show_image=false
boot_splash/bg_color=Color(0.04, 0.05, 0.09, 1)
config/icon="res://icon.png"

[debug]

gdscript/warnings/enable=false
file_logging/enable_file_logging=true
file_logging/log_path="user://logs/godot.log"

[autoload]

Config="*res://scripts/autoload/config.gd"
GameState="*res://scripts/autoload/game_state.gd"
Quests="*res://scripts/autoload/quest_manager.gd"
Inv="*res://scripts/autoload/inventory.gd"
SaveMan="*res://scripts/autoload/save_manager.gd"
AudioMan="*res://scripts/autoload/audio_manager.gd"
MapMan="*res://scripts/autoload/map_manager.gd"
InputRouter="*res://scripts/autoload/input_router.gd"
UITheme="*res://scripts/autoload/ui_theme.gd"
Fx="*res://scripts/autoload/fx.gd"
Dialogue="*res://scripts/autoload/dialogue.gd"
HUD="*res://scripts/autoload/hud.gd"
ShopUI="*res://scripts/autoload/shop_ui.gd"
InvUI="*res://scripts/autoload/inventory_ui.gd"
MapUI="*res://scripts/autoload/map_ui.gd"
PauseMenu="*res://scripts/autoload/pause_menu.gd"
GameOverUI="*res://scripts/autoload/game_over_ui.gd"
ShotRunner="*res://scripts/autoload/shot_runner.gd"

[display]

window/size/viewport_width=640
window/size/viewport_height=360
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"
window/stretch/aspect="keep"

